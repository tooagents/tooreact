APP_NAME=TooAcc API
APP_ENV=dev
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
OPENAI_MODEL_DEFAULT=gpt-5.4-mini
