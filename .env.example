DEFAULT_TAX_JURISDICTION=CA
MAIN_COLOR=#F28500
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOOACC_API_BASE=http://localhost:8000/api/v1
TOOACC_OWNER_ID=
